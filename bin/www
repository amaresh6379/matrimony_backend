#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../index');
var debug = require('debug')('matrimony-backend:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port, '0.0.0.0', () => {
  console.log(`Server listening on ${port}`);
});

server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

const https = require('https');

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);

  // Start self-pinging to prevent Render from sleeping (cold start problem)
  const HEALTH_URL = process.env.HEALTH_CHECK_URL || 'https://matrimony-backend-gfze.onrender.com/v1/health';

  const pingSelf = () => {
    https.get(HEALTH_URL, (res) => {
      console.log(`[Self-Ping] Status is ${res.statusCode}`);
    }).on('error', (err) => {
      console.error(`[Self-Ping] Request failed: ${err.message}`);
    });
  };

  // Ping once after 10 seconds of startup
  setTimeout(pingSelf, 10000);

  // Ping every 2 minutes
  setInterval(pingSelf, 120000);
}
